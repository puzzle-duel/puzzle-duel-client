{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "puzzle-duel-gameplay-fixture-v1.schema.json",
  "title": "Puzzle Duel canonical gameplay fixture v1",
  "description": "Language-neutral golden fixture for CORE-001 / PZD-11. Coordinates are zero-based [row, column]. Row 0 is the top row because rows increase downward. up decreases row, down increases row, left decreases column, right increases column. cells[row][column] stores the cell. Row-major index is row*boardSize+column. This file describes fixture documents only. It is not a service endpoint and not the product engine.",
  "oneOf": [
    { "$ref": "#/$defs/fullMoveFixture" },
    { "$ref": "#/$defs/phaseFixture" }
  ],
  "$defs": {
    "rulesVersion": {
      "const": "core-001.v1",
      "description": "Fixture-suite pin for CORE-001 as specified by the PZD-11 contract. No separate accepted version token exists yet."
    },
    "ruleId": {
      "enum": [
        "CORE-001",
        "PZD-11-PLACEMENT",
        "PZD-11-INVALID-MOVE",
        "PZD-11-MATCH",
        "PZD-11-SHIFT",
        "PZD-11-SCORE",
        "PZD-11-END",
        "PZD-11-OFFER-STREAM",
        "PZD-11-REPLAY"
      ]
    },
    "shape": { "enum": ["circle", "diamond", "triangle"] },
    "direction": { "enum": ["up", "right", "down", "left"] },
    "coordinate": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "piece": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "direction"],
      "properties": {
        "shape": { "$ref": "#/$defs/shape" },
        "direction": { "$ref": "#/$defs/direction" }
      }
    },
    "cell": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/piece" }
      ]
    },
    "status": {
      "enum": ["in_progress", "ended"],
      "description": "Fixture vocabulary for the contract status field. in_progress: turnsUsed < moveLimit and at least one empty non-blocked cell. ended: turnsUsed >= moveLimit or no empty non-blocked cell. The words are the suite's names for those two contract states."
    },
    "errorCode": {
      "enum": ["blocked_tap", "occupied_tap", "game_ended"],
      "description": "Typed rejection names for the cases the contract requires. game_ended is pinned only when the tap would otherwise be a legal empty cell. Precedence against blocked_tap or occupied_tap is not defined."
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rulesVersion", "boardSize", "moveLimit", "blocked", "cells", "offers", "futurePieces", "turnsUsed", "score", "status"],
      "properties": {
        "rulesVersion": { "$ref": "#/$defs/rulesVersion" },
        "boardSize": { "type": "integer", "minimum": 1 },
        "moveLimit": { "type": "integer", "minimum": 1 },
        "blocked": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/coordinate" },
          "description": "Static obstacles, unique, row-major. Each listed cell is empty."
        },
        "cells": {
          "type": "array",
          "description": "cells[row][column]. Length of cells and of each row is boardSize.",
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/cell" }
          }
        },
        "offers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/piece" }
        },
        "futurePieces": {
          "type": "array",
          "items": { "$ref": "#/$defs/piece" },
          "description": "Ordered replacement stream. Consuming an offer when this array is empty is not specified and is not pinned."
        },
        "turnsUsed": { "type": "integer", "minimum": 0 },
        "score": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offerIndex", "tap"],
      "properties": {
        "offerIndex": { "enum": [0, 1, 2] },
        "tap": { "$ref": "#/$defs/coordinate" }
      }
    },
    "moved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIndex", "from", "to", "shape", "direction"],
      "properties": {
        "sourceIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Row-major index of from at the start of the shift."
        },
        "from": { "$ref": "#/$defs/coordinate" },
        "to": { "$ref": "#/$defs/coordinate" },
        "shape": { "$ref": "#/$defs/shape" },
        "direction": { "$ref": "#/$defs/direction" }
      },
      "description": "A piece that changed cells. Pieces that stay are omitted and remain visible on the board."
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wave", "cleared", "scoreDelta", "moved"],
      "properties": {
        "wave": { "type": "integer", "minimum": 1 },
        "cleared": {
          "type": "array",
          "items": { "$ref": "#/$defs/coordinate" },
          "description": "Unique cleared cells, row-major. Each clear is one wave."
        },
        "scoreDelta": { "type": "integer", "minimum": 0 },
        "moved": {
          "type": "array",
          "items": { "$ref": "#/$defs/moved" },
          "description": "Shift caused by this clear, sourceIndex ascending. The next wave, if any, is the match found after this shift."
        }
      }
    },
    "legalStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal", "landing", "turnsUsed", "scoreDelta", "waves", "finalState"],
      "properties": {
        "legal": { "const": true },
        "landing": { "$ref": "#/$defs/coordinate" },
        "turnsUsed": {
          "type": "integer",
          "minimum": 1,
          "description": "Absolute turnsUsed after the step, identical to finalState.turnsUsed. A legal step increases the previous total by exactly 1."
        },
        "scoreDelta": { "type": "integer", "minimum": 0 },
        "waves": {
          "type": "array",
          "items": { "$ref": "#/$defs/wave" },
          "description": "Empty when the placement causes no clear. No clear means no shift."
        },
        "finalState": { "$ref": "#/$defs/state" }
      }
    },
    "illegalStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal", "error", "state"],
      "properties": {
        "legal": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": { "code": { "$ref": "#/$defs/errorCode" } }
        },
        "state": { "$ref": "#/$defs/state" }
      }
    },
    "fullScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "given", "when", "expected", "derivation"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "given": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "$ref": "#/$defs/state" } }
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["moves"],
          "properties": {
            "moves": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/move" } }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["steps"],
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": { "oneOf": [{ "$ref": "#/$defs/legalStep" }, { "$ref": "#/$defs/illegalStep" }] }
            },
            "repeat": {
              "type": "object",
              "additionalProperties": false,
              "required": ["runs", "sameInitialState", "deepEqual"],
              "properties": {
                "runs": { "type": "integer", "minimum": 2 },
                "sameInitialState": { "const": true },
                "deepEqual": { "const": true }
              }
            }
          }
        },
        "derivation": { "type": "string", "minLength": 80 }
      }
    },
    "matchGiven": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rulesVersion", "boardSize", "blocked", "cells", "wave"],
      "properties": {
        "rulesVersion": { "$ref": "#/$defs/rulesVersion" },
        "boardSize": { "type": "integer", "minimum": 1 },
        "blocked": { "type": "array", "items": { "$ref": "#/$defs/coordinate" } },
        "cells": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/cell" } } },
        "wave": { "type": "integer", "minimum": 1 }
      }
    },
    "shiftGiven": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rulesVersion", "boardSize", "blocked", "cells"],
      "properties": {
        "rulesVersion": { "$ref": "#/$defs/rulesVersion" },
        "boardSize": { "type": "integer", "minimum": 1 },
        "blocked": { "type": "array", "items": { "$ref": "#/$defs/coordinate" } },
        "cells": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/cell" } } }
      }
    },
    "fullMoveFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "kind", "rulesVersion", "ruleIds", "summary", "scenarios"],
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "integer", "minimum": 1, "maximum": 12 },
        "kind": { "const": "fullMove" },
        "rulesVersion": { "$ref": "#/$defs/rulesVersion" },
        "ruleIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ruleId" } },
        "summary": { "type": "string", "minLength": 20 },
        "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fullScenario" } }
      }
    },
    "phaseFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "kind", "phase", "rulesVersion", "ruleIds", "summary", "scenarios"],
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "integer", "minimum": 1, "maximum": 12 },
        "kind": { "const": "phase" },
        "phase": { "enum": ["match", "shift"] },
        "rulesVersion": { "$ref": "#/$defs/rulesVersion" },
        "ruleIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ruleId" } },
        "summary": { "type": "string", "minLength": 20 },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "given", "when", "expected", "derivation"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "given": { "oneOf": [{ "$ref": "#/$defs/matchGiven" }, { "$ref": "#/$defs/shiftGiven" }] },
              "when": {
                "type": "object",
                "additionalProperties": false,
                "required": ["phase"],
                "properties": { "phase": { "enum": ["match", "shift"] } }
              },
              "expected": { "type": "object" },
              "derivation": { "type": "string", "minLength": 80 }
            }
          }
        }
      }
    }
  }
}
